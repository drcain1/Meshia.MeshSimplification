<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:DropdownField label="Language" name="LanguagePicker" />
    <ui:HelpBox name="AttachedToRootWarning" message-type="Warning" text="This component should not be attached to root GameObject." style="display: none;" />
    <ui:VisualElement name="MainElement" style="flex-grow: 1;">
        <ui:DropdownField label="Algorithm for All Meshes" name="AllMeshesAlgorithmField" tooltip="Choose an algorithm to apply to every mesh entry. Individual mesh options and triangle targets are retained." />
        <ui:Button text="Apply Conservative Defaults to All Meshes" name="ConservativeDefaultsButton" tooltip="Replaces mesh protection options and joint-bone selections with conservative defaults. Keeps algorithms, triangle targets, and enabled/fixed choices. Undo is supported." />
        <ui:HelpBox text="Protection takes priority over the triangle target. Auto Adjust changes allocations, never disables guards. Preview counts may be stale; Analyze NDMF Build verifies the final budget." message-type="Info" />
        <ui:GroupBox style="flex-direction: row;">
            <ui:IntegerField label="Target Triangle Count" value="70000" name="TargetTriangleCountField" binding-path="TargetTriangleCount" />
            <ui:DropdownField name="TargetTriangleCountPresetDropdownField" />
        </ui:GroupBox>
        <ui:GroupBox style="flex-direction: row;">
            <ui:Button text="Adjust" parse-escape-sequences="true" display-tooltip-when-elided="true" enable-rich-text="false" name="AdjustButton" />
            <ui:Toggle label="Enable Auto Adjust" binding-path="AutoAdjustEnabled" name="AutoAdjustEnabledToggle" />
        </ui:GroupBox>
        <ui:GroupBox style="flex-direction: row; justify-content: space-between; align-items: flex-start; display: flex;">
            <ui:IMGUIContainer name="TriangleCountLabel" style="flex-grow: 1;" />
            <ui:GroupBox style="flex-direction: column;">
                <ui:Button text="Analyze NDMF Build" tooltip="Builds a temporary avatar clone through the complete NDMF pipeline and reports its exact final triangle count." name="AnalyzeNdmfBuildButton" />
                <ui:Button text="Remove Invalid Entries" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RemoveInvalidEntriesButton" />
                <ui:Button text="Reset" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResetButton" />
            </ui:GroupBox>
        </ui:GroupBox>
        <ui:ListView selection-type="None" name="EntriesListView" show-bound-collection-size="false" virtualization-method="DynamicHeight" binding-path="Entries" />
        <ui:Toggle label="Enable NDMF Preview" name="NdmfPreviewToggle" />
    </ui:VisualElement>
</ui:UXML>
