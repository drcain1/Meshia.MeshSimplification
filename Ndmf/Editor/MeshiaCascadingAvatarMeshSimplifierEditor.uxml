<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:DropdownField label="Language" name="LanguagePicker" />
    <ui:HelpBox name="AttachedToRootWarning" message-type="Warning" text="This component should not be attached to root GameObject." style="display: none;" />
    <ui:VisualElement name="MainElement" style="flex-grow: 1;">
        <ui:DropdownField label="Algorithm for All Meshes" name="AllMeshesAlgorithmField" tooltip="Choose an algorithm to apply to every mesh entry. Individual mesh options and triangle targets are retained." />
        <ui:VisualElement name="ProtectionPresetRow" style="flex-direction: row; flex-wrap: wrap;">
            <ui:Label text="Protection preset" style="align-self: center;" />
            <ui:Button text="Conservative" name="ConservativeDefaultsButton" tooltip="Apply conservative protection to all meshes. Keeps algorithms, targets, exclusions, and locks. Supports Undo." style="flex-grow: 1; flex-basis: 0;" />
            <ui:Button text="Aggressive" name="AggressiveDefaultsButton" tooltip="Reduce more while keeping extra protection on detected hands, hair, and face meshes. Check bent poses and clothing after applying. Keeps algorithms, targets, exclusions, and locks. Supports Undo." style="flex-grow: 1; flex-basis: 0;" />
            <ui:Button text="Extreme" name="ExtremeDefaultsButton" tooltip="Allow the most reduction on other meshes while keeping tighter limits on meshes selected for deformation protection. Check shapes and clothing edges after applying. Keeps algorithms, targets, exclusions, and locks. Supports Undo." style="flex-grow: 1; flex-basis: 0;" />
        </ui:VisualElement>
        <ui:GroupBox style="flex-direction: row;">
            <ui:IntegerField label="Requested Triangle Budget" tooltip="An allocation goal, not a hard cap. Protection can stop reduction above the requested budget." value="70000" name="TargetTriangleCountField" binding-path="TargetTriangleCount" />
            <ui:DropdownField name="TargetTriangleCountPresetDropdownField" />
        </ui:GroupBox>
        <ui:GroupBox style="flex-direction: row;">
            <ui:Button text="Adjust" tooltip="Redistribute the budget across unlocked meshes. This can raise targets you lowered manually. It does not guarantee the final count." name="AdjustButton" />
            <ui:Toggle label="Auto Adjust" tooltip="Changing one mesh's output rebalances the other unlocked meshes." binding-path="AutoAdjustEnabled" name="AutoAdjustEnabledToggle" />
        </ui:GroupBox>
        <ui:Foldout name="EstimatesAndBuildDetails" text="Triangle budget" value="true">
            <ui:Label name="AllocationSummary" tooltip="Uses measured changes from individual meshes and the last complete build. Later build steps may respond differently. Analyze Build verifies the final result." style="white-space: normal;" />
            <ui:Label name="BuildResultSummary" style="white-space: normal;" />
            <ui:Label name="BudgetSummary" style="white-space: normal; margin-top: 3px; margin-bottom: 3px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
                <ui:Button text="Analyze Build" tooltip="Builds a temporary avatar clone through the complete NDMF pipeline. With Auto Adjust enabled, fits and verifies allocations using up to four builds; otherwise analyzes once." name="AnalyzeNdmfBuildButton" />
                <ui:Button text="Find ways to reduce" name="FindBudgetReductionsButton" />
            </ui:VisualElement>
            <ui:Label name="AnalysisRunSummary" style="white-space: normal; display: none;" />
            <ui:Foldout name="CalculationDetails" text="Calculation details" value="false">
                <ui:VisualElement name="BuildReserveRow" style="flex-direction: row; flex-wrap: wrap; display: none;">
                    <ui:Label name="BuildReserveSummary" style="white-space: normal;" tooltip="Measured build corrections are retained by Adjust and Auto Adjust. Slider edits redistribute allocations without changing this correction. Analyze Build verifies the final count." />
                    <ui:Button name="ClearBuildReserveButton" text="Reset build correction" tooltip="Clear the saved build correction. Existing allocations remain until you adjust them again." style="display: none;" />
                </ui:VisualElement>
                <ui:Label name="TriangleCountLabel" style="white-space: normal;" />
                <ui:VisualElement name="PreviewShortfalls" style="display: none;">
                    <ui:HelpBox name="PreviewShortfallSummary" message-type="Info" />
                </ui:VisualElement>
                <ui:Label text="Shape protection can limit how far a mesh can be reduced. Analyze Build checks your avatar's final triangle count." style="white-space: normal;" />
                <ui:GroupBox style="flex-direction: row;">
                    <ui:Button text="Remove Invalid Entries" name="RemoveInvalidEntriesButton" />
                    <ui:Button text="Reset" name="ResetButton" />
                </ui:GroupBox>
            </ui:Foldout>
        </ui:Foldout>
        <ui:Foldout name="BudgetBreakdown" text="Mesh budget breakdown and next steps" value="false">
            <ui:HelpBox text="Start with geometry always covered by clothing. Use AAO Remove Mesh By BlendShape, or Modular Avatar Shape Changer in Delete mode, with a suitable body-hiding blendshape. Shrinking or visually hiding polygons alone does not remove them. Animated Shape Changer deletion does not lower the reported polygon count. Keep geometry needed by any outfit toggle, and analyze the build again." message-type="Info" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
                <ui:Button name="AaoRemovalGuideButton" text="AAO removal guide" />
                <ui:Button name="ShapeChangerGuideButton" text="Shape Changer guide" />
            </ui:VisualElement>
            <ui:Label text="Mesh outputs are measured before later build tools run. Preview counts are labeled separately. Analyze Build checks the final total." style="white-space: normal;" />
            <ui:Label text="Start with the largest meshes. If an output edit has no effect, review that mesh's protection settings and check its shape in motion." style="white-space: normal;" />
            <ui:Label text="Meshes listed as Not being simplified have reduction turned off. Enable it in mesh settings to include them. Unlock targets you want Auto Adjust to change." style="white-space: normal;" />
            <ui:ScrollView name="BudgetMeshScroll" style="max-height: 300px;">
                <ui:VisualElement name="BudgetMeshRows" />
            </ui:ScrollView>
        </ui:Foldout>
        <ui:Label text="Output / Original" tooltip="Measured mesh triangles before later build tools run. Edit an output count to request a change; Analyze Build verifies the avatar total." style="-unity-text-align: middle-right; margin-right: 56px;" />
        <ui:ListView selection-type="None" name="EntriesListView" show-bound-collection-size="false" virtualization-method="DynamicHeight" binding-path="Entries" />
        <ui:Toggle label="Enable NDMF Preview" name="NdmfPreviewToggle" />
    </ui:VisualElement>
</ui:UXML>
