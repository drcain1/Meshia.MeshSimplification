<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="MeshSimplifierOptionsDrawer.uss" />
    <ui:DropdownField label="Language" name="LanguagePicker" />
    <ui:Toggle label="Preserve Border Edges" binding-path="PreserveBorderEdges" name="PreserveBorderEdgesToggle" />
    <ui:VisualElement name="LegacyOptionsGroup">
        <ui:Toggle label="Preserve Surface Curvature" binding-path="PreserveSurfaceCurvature" />
        <ui:Toggle label="Use Barycentric Coordinate Interpolation" binding-path="UseBarycentricCoordinateInterpolation" />
        <ui:Slider label="Min Normal Dot" high-value="1" binding-path="MinNormalDot" low-value="-1" show-input-field="true" />
        <ui:Toggle label="Enable Smart Link" binding-path="EnableSmartLink" value="true" name="EnableSmartLinkToggle" />
        <ui:GroupBox text="Smart Link Options" name="SmartLinkOptionsGroup">
            <ui:FloatField label="Vertex Link Distance" value="0.001" binding-path="VertexLinkDistance" name="FloatField" />
            <ui:Slider label="Vertex Link Min Normal Dot" high-value="1" binding-path="VertexLinkMinNormalDot" low-value="-1" show-input-field="true" />
            <ui:FloatField label="Vertex Link Color Distance" value="0.01" binding-path="VertexLinkColorDistance" />
            <ui:Slider label="Vertex Link UV Distance" high-value="1.414214" binding-path="VertexLinkUvDistance" low-value="0" show-input-field="true" />
        </ui:GroupBox>
    </ui:VisualElement>
    <ui:HelpBox name="UvFallbackProtectionHelp" message-type="Info" text="Bone-weight protection applies only to the Blender Decimate fallback. UV loop removal uses its own built-in guards." />
    <ui:Foldout text="Skinning Protection" name="SkinningProtectionGroup">
        <ui:Toggle label="Automatically protect deforming meshes" name="SkinningProtectionAuto" tooltip="Protects each mesh using multiple bones, including clothing and custom rigs. Does not require a unique body mesh." />
        <ui:HelpBox name="LegacyAutomaticProtectionHelp" message-type="Info" text="This saved mesh uses legacy body-only Auto. Toggle Auto off and on to use per-mesh detection, or apply conservative defaults to update all protections." style="display:none" />
        <ui:Toggle label="Protect joint deformation" name="SkinningProtectionEnabled" tooltip="Manual override. Preserves skin-weight transitions near moving joints at the cost of fewer available collapses." />
        <uie:PropertyField binding-path="SkinningProtection.Policy" name="SkinningProtectionPolicyField" style="display:none" />
        <!-- Explicit fields keep localized labels when Unity binds the serialized values. -->
        <ui:FloatField label="Protection Strength" tooltip="Weight of the skinning deformation penalty when ranking collapses." binding-path="SkinningProtection.Strength" />
        <ui:FloatField label="Maximum Skin Weight Distance" tooltip="Maximum allowed difference between skin-weight distributions at the collapsed vertices." binding-path="SkinningProtection.MaxWeightDistance" />
        <ui:FloatField label="Maximum Discarded Skin Weight" tooltip="Maximum bone influence weight that may be discarded when merging vertices." binding-path="SkinningProtection.MaxDiscardedWeight" />
        <ui:HelpBox message-type="Info" text="Experimental. Applies to native Blender-style and FA-QEM decimation when enabled; it does not guarantee pose equivalence." />
    </ui:Foldout>
    <ui:Foldout text="FA-QEM Options" name="FaQemOptionsGroup">
        <ui:Toggle name="ExperimentalUvToggle" label="Preserve texture mapping (experimental)" binding-path="FaQem.ExperimentalUvEnabled" tooltip="Helps retain texture patterns while reducing triangles. May trade some shape accuracy for less UV distortion. Does not change texture images. Turn off to compare with the usual result." />
        <ui:Toggle name="ExperimentalJointUvToggle" label="Optimize shape and UV together (experimental)" binding-path="FaQem.ExperimentalJointUv" tooltip="Tries a joint vertex and UV placement. Keeps existing protections and falls back to the current method when the result is invalid. Rebuilds tangents for the changed mapping. Compare textures, normal maps and movement before using the result." />
        <ui:FloatField name="ExperimentalUvWeightField" label="UV protection strength" binding-path="FaQem.ExperimentalUvWeight" is-delayed="true" tooltip="Start at 1000. Try 100 for a gentler effect or 10000 for stronger texture protection. Check the shape and movement after changing it. This experimental scale is specific to FA-QEM. Analyze Build verifies the final result." />
        <ui:Toggle label="Preserve Vertices Near Joints" name="PreserveJointTransitionsToggle" binding-path="SkinningProtection.PreserveJointTransitions" tooltip="Preserves vertices where the strongest bone influence changes, plus their immediate neighbors, to help retain shape when joints bend. This can limit triangle reduction." />
        <ui:FloatField label="Plane Area Divisor" tooltip="Positive divisor applied to source triangle areas in the plane metric." binding-path="FaQem.PlaneAreaWeight" />
        <ui:FloatField label="Boundary Weight" tooltip="Weight of boundary curvature constraints." binding-path="FaQem.BoundaryWeight" />
        <ui:FloatField label="Normal Weight" tooltip="Weight of tangent planes derived from the original normals." binding-path="FaQem.NormalWeight" />
        <ui:FloatField label="Swept Area Weight" tooltip="Penalty for the area swept by a moving boundary edge." binding-path="FaQem.AreaWeight" />
        <ui:Toggle label="Use Inverse Area Weighting" tooltip="Weights source planes by inverse triangle area." binding-path="FaQem.UseInverseAreaWeighting" />
        <ui:Toggle label="Lock Coincident Split Vertices" tooltip="Locks separate vertices at the same position to help prevent cracks during simplification. Includes vertices split at UV or normal seams, even when their attributes match. Does not merge or weld vertices." binding-path="FaQem.PreserveAttributeSeams" />
        <ui:Slider low-value="0" high-value="1" show-input-field="true" label="Minimum Face Normal Dot" tooltip="Minimum dot product between a surviving face normal before and after a collapse. Higher values allow less rotation." binding-path="FaQem.MinNormalDot" />
        <ui:VisualElement style="flex-direction: row;">
            <ui:Slider name="SurfaceDeviationSlider" low-value="0" high-value="0.005" label="Maximum Surface Deviation" style="flex-grow: 1;" tooltip="Maximum sampled distance from the original surface as a fraction of mesh size. 0 disables the guard; 0.001 is 0.1% of the bounds diagonal. May stop above the triangle target. Slider range: 0–0.005; enter values up to 0.1 in the number field." />
            <ui:FloatField name="SurfaceDeviationField" style="width: 60px; flex-shrink: 0;" tooltip="Maximum sampled distance from the original surface as a fraction of mesh size. 0 disables the guard; 0.001 is 0.1% of the bounds diagonal. May stop above the triangle target. Slider range: 0–0.005; enter values up to 0.1 in the number field." />
        </ui:VisualElement>
    </ui:Foldout>
    <ui:Button text="Reset Options" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResetOptionsButton" enable-rich-text="false" />
</ui:UXML>
